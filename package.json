{
  "name": "polene-qa",
  "version": "1.0.0",
  "description": "QA automatisée Polène (Playwright)",
  "scripts": {
    "test": "playwright test",
    "test:prod": "QA_ENVS=prod playwright test",
    "test:preprod": "QA_ENVS=preprod playwright test",
    "type": "node scripts/lancer.mjs type",
    "page": "node scripts/lancer.mjs page",
    "catalogue": "node scripts/lancer.mjs",
    "test:donnees": "node scripts/lancer.mjs type donnees",
    "donnees:qa": "node scripts/donnees-qa.mjs",
    "connexion:compte": "node scripts/connexion-compte.mjs",
    "test:demo-echec": "node scripts/lancer.mjs type demo-echec",
    "test:visuel": "node scripts/lancer.mjs type visuel",
    "test:visuel:maj": "node scripts/sauvegarder-references.mjs && VISUEL=1 QA_ENVS=prod playwright test --grep @visuel --workers 2 --update-snapshots",
    "test:regressions": "node scripts/lancer.mjs type regressions",
    "test:accessibilite": "node scripts/lancer.mjs type accessibilite",
    "test:accessibilite:maj": "ACCESSIBILITE_MAJ=1 node scripts/lancer.mjs type accessibilite",
    "test:structure": "node scripts/lancer.mjs type structure",
    "test:structure:maj": "STRUCTURE_MAJ=1 node scripts/lancer.mjs type structure",
    "rapport:polene": "node scripts/ouvrir-rapport.mjs",
    "revue": "node scripts/ouvrir-rapport.mjs --revue",
    "rapport": "playwright show-report resultats/tnr/playwright-report",
    "archiver": "node scripts/archiver-rapport.mjs",
    "typecheck": "tsc"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@shopify/cli": "^4.8.5",
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.5",
    "typescript": "^7.0.2"
  },
  "private": true
}
