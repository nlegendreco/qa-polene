# Copier ce fichier en .env et remplir les valeurs. Le fichier .env n'est jamais versionné.

# Mot de passe de la boutique préprod (asia-polene.myshopify.com)
PREPROD_PASSWORD=

# Paiement de test en préprod : carte de test Shopify Payments (boutique en mode test)
# Date d'expiration future et CVV quelconques.
PREPROD_CARD_NUMBER=4242424242424242
PREPROD_CARD_EXPIRY=12/30
PREPROD_CARD_CVV=123
PREPROD_CARD_NAME=QA Polene

# Email du client de test pour les commandes préprod (une boîte que vous contrôlez).
# Le reste de l'identité du client de test est dans data/client-test.json.
PREPROD_EMAIL=

# Environnements à lancer (séparés par des virgules) : prod, preprod
QA_ENVS=prod,preprod
